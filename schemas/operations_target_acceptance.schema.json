{
  "$defs": {
    "CheckStatus": {
      "enum": [
        "pass",
        "fail",
        "skip"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "DrillType": {
      "enum": [
        "database_disconnect",
        "market_data_disconnect",
        "trade_update_disconnect",
        "broker_timeout",
        "clock_skew",
        "process_restart",
        "disk_pressure"
      ],
      "title": "DrillType",
      "type": "string"
    },
    "OperationsCheck": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        }
      },
      "required": [
        "name",
        "status",
        "required",
        "message"
      ],
      "title": "OperationsCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/OperationsCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "paper_ready": {
      "title": "Paper Ready",
      "type": "boolean"
    },
    "passed_drills": {
      "items": {
        "$ref": "#/$defs/DrillType"
      },
      "title": "Passed Drills",
      "type": "array"
    },
    "recovery_plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recovery Plan Id"
    },
    "report_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Hash",
      "type": "string"
    },
    "report_id": {
      "maxLength": 64,
      "minLength": 8,
      "title": "Report Id",
      "type": "string"
    },
    "required_drills": {
      "items": {
        "$ref": "#/$defs/DrillType"
      },
      "title": "Required Drills",
      "type": "array"
    },
    "restore_validation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Restore Validation Id"
    },
    "target_verified": {
      "title": "Target Verified",
      "type": "boolean"
    }
  },
  "required": [
    "report_id",
    "generated_at",
    "target_verified",
    "paper_ready",
    "checks",
    "required_drills",
    "passed_drills",
    "configuration_hash",
    "report_hash"
  ],
  "title": "TargetAcceptanceReport",
  "type": "object"
}
