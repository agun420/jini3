{
  "$defs": {
    "MetricSample": {
      "additionalProperties": false,
      "properties": {
        "labels": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Labels",
          "type": "array"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ],
      "title": "MetricSample",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "failures": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Failures",
      "type": "array"
    },
    "healthy": {
      "title": "Healthy",
      "type": "boolean"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricSample"
      },
      "title": "Metrics",
      "type": "array"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Hash",
      "type": "string"
    },
    "snapshot_id": {
      "maxLength": 64,
      "minLength": 8,
      "title": "Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "observed_at",
    "healthy",
    "metrics",
    "configuration_hash",
    "snapshot_hash"
  ],
  "title": "ObservabilitySnapshot",
  "type": "object"
}
