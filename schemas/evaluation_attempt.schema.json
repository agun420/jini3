{
  "$defs": {
    "ApprovedSetup": {
      "additionalProperties": false,
      "properties": {
        "catalyst_age_hours": {
          "minimum": 0,
          "title": "Catalyst Age Hours",
          "type": "number"
        },
        "catalyst_source": {
          "title": "Catalyst Source",
          "type": "string"
        },
        "conviction_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Conviction Score",
          "type": "integer"
        },
        "corroborated": {
          "title": "Corroborated",
          "type": "boolean"
        },
        "master_thesis": {
          "title": "Master Thesis",
          "type": "string"
        },
        "risk_flags": {
          "items": {
            "$ref": "#/$defs/RiskFlag"
          },
          "title": "Risk Flags",
          "type": "array"
        },
        "score_breakdown": {
          "$ref": "#/$defs/ScoreBreakdown"
        },
        "side": {
          "const": "long",
          "title": "Side",
          "type": "string"
        },
        "source_timestamp": {
          "title": "Source Timestamp",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "ticker": {
          "pattern": "^[A-Z0-9](?:[A-Z0-9.-]{0,13}[A-Z0-9])?$",
          "title": "Ticker",
          "type": "string"
        },
        "trade_parameters": {
          "$ref": "#/$defs/TradeParameters"
        }
      },
      "required": [
        "ticker",
        "side",
        "conviction_score",
        "score_breakdown",
        "master_thesis",
        "catalyst_source",
        "source_type",
        "source_timestamp",
        "catalyst_age_hours",
        "corroborated",
        "risk_flags",
        "trade_parameters"
      ],
      "title": "ApprovedSetup",
      "type": "object"
    },
    "AttemptRole": {
      "enum": [
        "primary",
        "shadow"
      ],
      "title": "AttemptRole",
      "type": "string"
    },
    "AttemptStatus": {
      "enum": [
        "succeeded",
        "deadline_exceeded",
        "transport_error",
        "refused",
        "incomplete",
        "empty_output",
        "invalid_json",
        "schema_invalid",
        "invariant_invalid",
        "canceled"
      ],
      "title": "AttemptStatus",
      "type": "string"
    },
    "BlockerCode": {
      "enum": [
        "MARKET_NOT_NORMAL",
        "PAYLOAD_STALE"
      ],
      "title": "BlockerCode",
      "type": "string"
    },
    "CatalystZeroReason": {
      "enum": [
        "disqualifier_flag",
        "unconfirmed_source",
        "stale_catalyst",
        "no_valid_driver"
      ],
      "title": "CatalystZeroReason",
      "type": "string"
    },
    "CheckStatus": {
      "enum": [
        "pass",
        "fail",
        "not_evaluated"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "DaybreakOutput": {
      "additionalProperties": false,
      "properties": {
        "approved_setups": {
          "items": {
            "$ref": "#/$defs/ApprovedSetup"
          },
          "title": "Approved Setups",
          "type": "array"
        },
        "excluded_tickers": {
          "items": {
            "$ref": "#/$defs/ExcludedTicker"
          },
          "title": "Excluded Tickers",
          "type": "array"
        },
        "execution_timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Execution Timestamp"
        },
        "market_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarketStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload_timestamp_used": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Payload Timestamp Used"
        },
        "qualified_not_selected": {
          "items": {
            "$ref": "#/$defs/QualifiedNotSelected"
          },
          "title": "Qualified Not Selected",
          "type": "array"
        },
        "run_blockers": {
          "items": {
            "$ref": "#/$defs/RunBlocker"
          },
          "title": "Run Blockers",
          "type": "array"
        },
        "run_status": {
          "$ref": "#/$defs/RunStatus"
        },
        "schema_failures": {
          "items": {
            "$ref": "#/$defs/SchemaFailure"
          },
          "title": "Schema Failures",
          "type": "array"
        }
      },
      "required": [
        "run_status",
        "execution_timestamp",
        "payload_timestamp_used",
        "market_status",
        "approved_setups",
        "qualified_not_selected",
        "excluded_tickers",
        "schema_failures",
        "run_blockers"
      ],
      "title": "DaybreakOutput",
      "type": "object"
    },
    "EvaluationSnapshot": {
      "additionalProperties": false,
      "properties": {
        "catalyst_magnitude_bucket": {
          "$ref": "#/$defs/MagnitudeBucket"
        },
        "catalyst_magnitude_points": {
          "maximum": 4,
          "minimum": 0,
          "title": "Catalyst Magnitude Points",
          "type": "integer"
        },
        "catalyst_points": {
          "maximum": 40,
          "minimum": 0,
          "title": "Catalyst Points",
          "type": "integer"
        },
        "catalyst_score_raw": {
          "maximum": 10,
          "minimum": 0,
          "title": "Catalyst Score Raw",
          "type": "integer"
        },
        "catalyst_zero_override": {
          "title": "Catalyst Zero Override",
          "type": "boolean"
        },
        "catalyst_zero_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalystZeroReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_purpose": {
          "$ref": "#/$defs/EvidencePurpose"
        },
        "magnitude_evidence_end_char": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Magnitude Evidence End Char"
        },
        "magnitude_evidence_excerpt": {
          "maxLength": 200,
          "title": "Magnitude Evidence Excerpt",
          "type": "string"
        },
        "magnitude_evidence_start_char": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Magnitude Evidence Start Char"
        },
        "magnitude_evidence_truncated": {
          "title": "Magnitude Evidence Truncated",
          "type": "boolean"
        },
        "parabolic_adjusted": {
          "title": "Parabolic Adjusted",
          "type": "boolean"
        },
        "risk_flags": {
          "items": {
            "$ref": "#/$defs/RiskFlag"
          },
          "title": "Risk Flags",
          "type": "array"
        },
        "source_quality_points": {
          "maximum": 6,
          "minimum": 0,
          "title": "Source Quality Points",
          "type": "integer"
        },
        "technical_base_points": {
          "enum": [
            0,
            13,
            22,
            25
          ],
          "title": "Technical Base Points",
          "type": "integer"
        },
        "technical_grade": {
          "$ref": "#/$defs/TechnicalGrade"
        },
        "technical_points": {
          "enum": [
            0,
            7,
            13,
            16,
            19,
            22,
            25
          ],
          "title": "Technical Points",
          "type": "integer"
        },
        "volume_points": {
          "enum": [
            0,
            15,
            25,
            35
          ],
          "title": "Volume Points",
          "type": "integer"
        }
      },
      "required": [
        "source_quality_points",
        "catalyst_magnitude_bucket",
        "catalyst_magnitude_points",
        "evidence_purpose",
        "magnitude_evidence_excerpt",
        "magnitude_evidence_truncated",
        "magnitude_evidence_start_char",
        "magnitude_evidence_end_char",
        "catalyst_zero_override",
        "catalyst_zero_reason",
        "catalyst_score_raw",
        "catalyst_points",
        "volume_points",
        "technical_grade",
        "technical_base_points",
        "technical_points",
        "parabolic_adjusted",
        "risk_flags"
      ],
      "title": "EvaluationSnapshot",
      "type": "object"
    },
    "EvidencePurpose": {
      "enum": [
        "magnitude",
        "disqualifier",
        "none"
      ],
      "title": "EvidencePurpose",
      "type": "string"
    },
    "ExcludedTicker": {
      "additionalProperties": false,
      "properties": {
        "additional_reasons": {
          "items": {
            "$ref": "#/$defs/ReasonObject"
          },
          "title": "Additional Reasons",
          "type": "array"
        },
        "evaluation_snapshot": {
          "$ref": "#/$defs/EvaluationSnapshot"
        },
        "primary_reason": {
          "$ref": "#/$defs/ReasonObject"
        },
        "ticker": {
          "pattern": "^[A-Z0-9](?:[A-Z0-9.-]{0,13}[A-Z0-9])?$",
          "title": "Ticker",
          "type": "string"
        }
      },
      "required": [
        "ticker",
        "primary_reason",
        "additional_reasons",
        "evaluation_snapshot"
      ],
      "title": "ExcludedTicker",
      "type": "object"
    },
    "InvariantCheck": {
      "additionalProperties": false,
      "properties": {
        "invariant_number": {
          "maximum": 77,
          "minimum": 1,
          "title": "Invariant Number",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        },
        "violations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InvariantViolation"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "invariant_number",
        "name",
        "status"
      ],
      "title": "InvariantCheck",
      "type": "object"
    },
    "InvariantViolation": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "title": "Expected",
          "type": "string"
        },
        "invariant_number": {
          "maximum": 77,
          "minimum": 1,
          "title": "Invariant Number",
          "type": "integer"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "observed": {
          "title": "Observed",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "invariant_number",
        "path",
        "expected",
        "observed",
        "message"
      ],
      "title": "InvariantViolation",
      "type": "object"
    },
    "MagnitudeBucket": {
      "enum": [
        "major_concrete",
        "material_partially_quantified",
        "credible_unquantified",
        "weak_or_preliminary",
        "no_valid_driver"
      ],
      "title": "MagnitudeBucket",
      "type": "string"
    },
    "MarketStatus": {
      "enum": [
        "normal",
        "limit_up_down_active",
        "circuit_breaker_halt"
      ],
      "title": "MarketStatus",
      "type": "string"
    },
    "QualifiedNotSelected": {
      "additionalProperties": false,
      "properties": {
        "catalyst_age_hours": {
          "minimum": 0,
          "title": "Catalyst Age Hours",
          "type": "number"
        },
        "catalyst_source": {
          "title": "Catalyst Source",
          "type": "string"
        },
        "conviction_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Conviction Score",
          "type": "integer"
        },
        "corroborated": {
          "title": "Corroborated",
          "type": "boolean"
        },
        "final_rank": {
          "minimum": 4,
          "title": "Final Rank",
          "type": "integer"
        },
        "non_selection_reason_code": {
          "const": "TOP_THREE_CAP",
          "title": "Non Selection Reason Code",
          "type": "string"
        },
        "risk_flags": {
          "items": {
            "$ref": "#/$defs/RiskFlag"
          },
          "title": "Risk Flags",
          "type": "array"
        },
        "score_breakdown": {
          "$ref": "#/$defs/ScoreBreakdown"
        },
        "source_timestamp": {
          "title": "Source Timestamp",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "ticker": {
          "pattern": "^[A-Z0-9](?:[A-Z0-9.-]{0,13}[A-Z0-9])?$",
          "title": "Ticker",
          "type": "string"
        }
      },
      "required": [
        "ticker",
        "final_rank",
        "conviction_score",
        "score_breakdown",
        "catalyst_source",
        "source_type",
        "source_timestamp",
        "catalyst_age_hours",
        "corroborated",
        "risk_flags",
        "non_selection_reason_code"
      ],
      "title": "QualifiedNotSelected",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "HALTED",
        "CATALYST_SCORE_TOO_LOW",
        "UNCORROBORATED_CATALYST",
        "GAP_TOO_SMALL",
        "PREMARKET_VOLUME_TOO_LOW",
        "RVOL_TOO_LOW",
        "RESISTANCE_TOO_CLOSE",
        "CAPPED_CHART"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ReasonObject": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "observed_value": {
          "title": "Observed Value",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "required_condition": {
          "title": "Required Condition",
          "type": "string"
        }
      },
      "required": [
        "reason_code",
        "field",
        "observed_value",
        "required_condition",
        "reason"
      ],
      "title": "ReasonObject",
      "type": "object"
    },
    "RiskFlag": {
      "enum": [
        "parabolic_vwap_extension",
        "hard_to_borrow",
        "unknown_borrow",
        "low_float",
        "spiky_volume",
        "secondary_source"
      ],
      "title": "RiskFlag",
      "type": "string"
    },
    "RunBlocker": {
      "additionalProperties": false,
      "properties": {
        "blocker_code": {
          "$ref": "#/$defs/BlockerCode"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "observed_value": {
          "title": "Observed Value",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "required_condition": {
          "title": "Required Condition",
          "type": "string"
        }
      },
      "required": [
        "blocker_code",
        "field",
        "observed_value",
        "required_condition",
        "reason"
      ],
      "title": "RunBlocker",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "approved",
        "no_setups",
        "blocked_market",
        "stale_payload",
        "schema_failure"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SchemaFailure": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/SchemaFailureScope"
        },
        "ticker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ticker"
        }
      },
      "required": [
        "scope",
        "ticker",
        "field",
        "reason"
      ],
      "title": "SchemaFailure",
      "type": "object"
    },
    "SchemaFailureScope": {
      "enum": [
        "payload",
        "ticker"
      ],
      "title": "SchemaFailureScope",
      "type": "string"
    },
