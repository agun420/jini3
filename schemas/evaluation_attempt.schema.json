          "type": "integer"
        },
        "catalyst_points": {
          "maximum": 40,
          "minimum": 0,
          "title": "Catalyst Points",
          "type": "integer"
        },
        "catalyst_score_raw": {
          "maximum": 10,
          "minimum": 0,
          "title": "Catalyst Score Raw",
          "type": "integer"
        },
        "catalyst_zero_override": {
          "title": "Catalyst Zero Override",
          "type": "boolean"
        },
        "catalyst_zero_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalystZeroReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_purpose": {
          "$ref": "#/$defs/EvidencePurpose"
        },
        "magnitude_evidence_end_char": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Magnitude Evidence End Char"
        },
        "magnitude_evidence_excerpt": {
          "maxLength": 200,
          "title": "Magnitude Evidence Excerpt",
          "type": "string"
        },
        "magnitude_evidence_start_char": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Magnitude Evidence Start Char"
        },
        "magnitude_evidence_truncated": {
          "title": "Magnitude Evidence Truncated",
          "type": "boolean"
        },
        "parabolic_adjusted": {
          "title": "Parabolic Adjusted",
          "type": "boolean"
        },
        "source_quality_points": {
          "maximum": 6,
          "minimum": 0,
          "title": "Source Quality Points",
          "type": "integer"
        },
        "technical_base_points": {
          "enum": [
            0,
            13,
            22,
            25
          ],
          "title": "Technical Base Points",
          "type": "integer"
        },
        "technical_grade": {
          "$ref": "#/$defs/TechnicalGrade"
        },
        "technical_points": {
          "enum": [
            0,
            7,
            13,
            16,
            19,
            22,
            25
          ],
          "title": "Technical Points",
          "type": "integer"
        },
        "volume_points": {
          "enum": [
            0,
            15,
            25,
            35
          ],
          "title": "Volume Points",
          "type": "integer"
        }
      },
      "required": [
        "source_quality_points",
        "catalyst_magnitude_bucket",
        "catalyst_magnitude_points",
        "evidence_purpose",
        "magnitude_evidence_excerpt",
        "magnitude_evidence_truncated",
        "magnitude_evidence_start_char",
        "magnitude_evidence_end_char",
        "catalyst_zero_override",
        "catalyst_zero_reason",
        "catalyst_score_raw",
        "catalyst_points",
        "volume_points",
        "technical_grade",
        "technical_base_points",
        "technical_points",
        "parabolic_adjusted"
      ],
      "title": "ScoreBreakdown",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "primary",
        "secondary",
        "unconfirmed"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "TechnicalGrade": {
      "enum": [
        "A+",
        "A",
        "B",
        "C"
      ],
      "title": "TechnicalGrade",
      "type": "string"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "properties": {
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reasoning Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    },
    "TradeParameters": {
      "additionalProperties": false,
      "properties": {
        "atr_value_used": {
          "exclusiveMinimum": 0,
          "title": "Atr Value Used",
          "type": "number"
        },
        "invalidation_note": {
          "const": "Thesis is invalid if price breaks below the supplied premarket low before 9:35 AM ET.",
          "title": "Invalidation Note",
          "type": "string"
        },
        "premarket_low_used": {
          "exclusiveMinimum": 0,
          "title": "Premarket Low Used",
          "type": "number"
        },
        "profit_target_atr_multiple": {
          "maximum": 2.0,
          "minimum": 2.0,
          "title": "Profit Target Atr Multiple",
          "type": "number"
        },
        "reference_price": {
          "exclusiveMinimum": 0,
          "title": "Reference Price",
          "type": "number"
        },
        "risk_stop_atr_multiple": {
          "maximum": 1.0,
          "minimum": 1.0,
          "title": "Risk Stop Atr Multiple",
          "type": "number"
        }
      },
      "required": [
        "reference_price",
        "atr_value_used",
        "premarket_low_used",
        "risk_stop_atr_multiple",
        "profit_target_atr_multiple",
        "invalidation_note"
      ],
      "title": "TradeParameters",
      "type": "object"
    },
    "ValidationReport": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InvariantCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "execution_ready": {
          "title": "Execution Ready",
          "type": "boolean"
        },
        "model_errors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Model Errors",
          "type": "array"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "execution_ready"
      ],
      "title": "ValidationReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt_number": {
      "maximum": 2,
