{
  "$defs": {
    "ExitReason": {
      "enum": [
        "target",
        "stop",
        "time_exit",
        "kill_switch",
        "manual_safety",
        "broker_reconciliation"
      ],
      "title": "ExitReason",
      "type": "string"
    },
    "TradeOutcome": {
      "additionalProperties": false,
      "properties": {
        "average_entry_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Average Entry Price"
        },
        "average_exit_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Average Exit Price"
        },
        "chart_structure": {
          "enum": [
            "blue_sky",
            "clean_short_term",
            "moderate_room"
          ],
          "title": "Chart Structure",
          "type": "string"
        },
        "entry_timestamp": {
          "format": "date-time",
          "title": "Entry Timestamp",
          "type": "string"
        },
        "exit_reason": {
          "$ref": "#/$defs/ExitReason"
        },
        "exit_timestamp": {
          "format": "date-time",
          "title": "Exit Timestamp",
          "type": "string"
        },
        "fees": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Fees"
        },
        "final_rank": {
          "maximum": 3,
          "minimum": 1,
          "title": "Final Rank",
          "type": "integer"
        },
        "planned_entry_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Planned Entry Price"
        },
        "planned_stop_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Planned Stop Price"
        },
        "planned_target_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Planned Target Price"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "risk_flags": {
          "default": [],
          "items": {
            "enum": [
              "parabolic_vwap_extension",
              "hard_to_borrow",
              "unknown_borrow",
              "low_float",
              "spiky_volume",
              "secondary_source"
            ],
            "type": "string"
          },
          "title": "Risk Flags",
          "type": "array"
        },
        "session_id": {
          "maxLength": 64,
          "minLength": 8,
          "title": "Session Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "primary",
            "secondary"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "ticker": {
          "pattern": "^[A-Z0-9](?:[A-Z0-9.-]{0,13}[A-Z0-9])?$",
          "title": "Ticker",
          "type": "string"
        },
        "trade_id": {
          "maxLength": 64,
          "minLength": 8,
          "title": "Trade Id",
          "type": "string"
        }
      },
      "required": [
        "trade_id",
        "session_id",
        "ticker",
        "final_rank",
        "quantity",
        "entry_timestamp",
        "exit_timestamp",
        "planned_entry_price",
        "average_entry_price",
        "planned_stop_price",
        "planned_target_price",
        "average_exit_price",
        "source_type",
        "chart_structure",
        "exit_reason"
      ],
      "title": "TradeOutcome",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "all_positions_flat": {
      "title": "All Positions Flat",
      "type": "boolean"
    },
    "approved_setup_count": {
      "maximum": 3,
      "minimum": 0,
      "title": "Approved Setup Count",
      "type": "integer"
    },
    "configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "duplicate_order_count": {
      "minimum": 0,
      "title": "Duplicate Order Count",
      "type": "integer"
    },
    "evaluator_run_count": {
      "minimum": 0,
      "title": "Evaluator Run Count",
      "type": "integer"
    },
    "excluded_ticker_count": {
      "minimum": 0,
      "title": "Excluded Ticker Count",
      "type": "integer"
    },
    "full_session_recorded": {
      "title": "Full Session Recorded",
      "type": "boolean"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "invariant_violations": {
      "minimum": 0,
      "title": "Invariant Violations",
      "type": "integer"
    },
    "kill_switch_activation_count": {
      "minimum": 0,
      "title": "Kill Switch Activation Count",
      "type": "integer"
    },
    "late_primary_response_count": {
      "minimum": 0,
      "title": "Late Primary Response Count",
      "type": "integer"
    },
    "orders_filled": {
      "minimum": 0,
      "title": "Orders Filled",
      "type": "integer"
    },
    "orders_submitted": {
      "minimum": 0,
      "title": "Orders Submitted",
      "type": "integer"
    },
    "qualified_not_selected_count": {
      "minimum": 0,
      "title": "Qualified Not Selected Count",
      "type": "integer"
    },
    "raw_event_count": {
      "minimum": 0,
      "title": "Raw Event Count",
      "type": "integer"
    },
    "session_id": {
      "maxLength": 64,
      "minLength": 8,
      "title": "Session Id",
      "type": "string"
    },
    "trades": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TradeOutcome"
      },
      "title": "Trades",
      "type": "array"
    },
    "trading_date": {
      "format": "date",
      "title": "Trading Date",
      "type": "string"
    },
    "unresolved_reconciliations": {
      "minimum": 0,
      "title": "Unresolved Reconciliations",
      "type": "integer"
    }
  },
  "required": [
    "session_id",
    "trading_date",
    "generated_at",
    "configuration_hash",
    "full_session_recorded",
    "raw_event_count",
    "evaluator_run_count",
    "approved_setup_count",
    "qualified_not_selected_count",
    "excluded_ticker_count",
    "orders_submitted",
    "orders_filled",
    "invariant_violations",
    "unresolved_reconciliations",
    "duplicate_order_count",
    "late_primary_response_count",
    "all_positions_flat",
    "kill_switch_activation_count"
  ],
  "title": "SessionEvidence",
  "type": "object"
}
