          "title": "Frozen At",
          "type": "string"
        },
        "live_execution_enabled": {
          "const": false,
          "title": "Live Execution Enabled",
          "type": "boolean"
        },
        "migration_head": {
          "const": "0009_phase9_release",
          "title": "Migration Head",
          "type": "string"
        },
        "release_version": {
          "const": "1.0.2",
          "title": "Release Version",
          "type": "string"
        },
        "specification_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Specification Sha256",
          "type": "string"
        },
        "specification_version": {
          "const": "6.3",
