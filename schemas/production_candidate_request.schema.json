{
  "$defs": {
    "AcceptanceStatus": {
      "enum": [
        "collecting",
        "blocked",
        "paper_qualified"
      ],
      "title": "AcceptanceStatus",
      "type": "string"
    },
    "AggregatePerformance": {
      "additionalProperties": false,
      "properties": {
        "average_r_multiple": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Average R Multiple"
        },
        "expectancy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Expectancy"
        },
        "fees": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Fees"
        },
        "gross_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Gross Pnl"
        },
        "maximum_drawdown": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Maximum Drawdown"
        },
        "net_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Net Pnl"
        },
        "profit_factor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Profit Factor"
        },
        "session_count": {
          "minimum": 0,
          "title": "Session Count",
          "type": "integer"
        },
        "trade_count": {
          "minimum": 0,
          "title": "Trade Count",
          "type": "integer"
        },
        "win_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Win Rate"
        }
      },
      "required": [
        "session_count",
        "trade_count",
        "gross_pnl",
        "fees",
        "net_pnl",
        "win_rate",
        "profit_factor",
        "expectancy",
        "maximum_drawdown",
        "average_r_multiple"
      ],
      "title": "AggregatePerformance",
      "type": "object"
    },
    "AnalyticsPolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_live_certification": {
          "const": false,
          "default": false,
          "title": "Allow Live Certification",
          "type": "boolean"
        },
        "maximum_duplicate_orders": {
          "default": 0,
          "minimum": 0,
          "title": "Maximum Duplicate Orders",
          "type": "integer"
        },
        "maximum_invariant_violations": {
          "default": 0,
          "minimum": 0,
          "title": "Maximum Invariant Violations",
          "type": "integer"
        },
        "maximum_late_primary_responses": {
          "default": 0,
          "minimum": 0,
          "title": "Maximum Late Primary Responses",
          "type": "integer"
        },
        "maximum_unresolved_reconciliations": {
          "default": 0,
          "minimum": 0,
          "title": "Maximum Unresolved Reconciliations",
          "type": "integer"
        },
        "minimum_clean_session_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "1",
          "title": "Minimum Clean Session Rate"
        },
        "minimum_filled_orders": {
          "default": 50,
          "maximum": 10000,
          "minimum": 1,
          "title": "Minimum Filled Orders",
          "type": "integer"
        },
        "minimum_sessions": {
          "default": 30,
          "maximum": 365,
          "minimum": 1,
          "title": "Minimum Sessions",
          "type": "integer"
        },
        "mode": {
          "const": "paper",
          "default": "paper",
          "title": "Mode",
          "type": "string"
        },
        "performance_is_acceptance_gate": {
          "const": false,
          "default": false,
          "title": "Performance Is Acceptance Gate",
          "type": "boolean"
        },
        "policy_version": {
          "const": "analytics_policy_v1",
          "default": "analytics_policy_v1",
          "title": "Policy Version",
          "type": "string"
        },
        "require_all_positions_flat": {
          "const": true,
          "default": true,
          "title": "Require All Positions Flat",
          "type": "boolean"
        },
        "require_complete_replay": {
          "const": true,
          "default": true,
          "title": "Require Complete Replay",
          "type": "boolean"
        },
        "require_restore_validation": {
          "const": true,
          "default": true,
          "title": "Require Restore Validation",
          "type": "boolean"
        },
        "require_target_acceptance": {
          "const": true,
          "default": true,
          "title": "Require Target Acceptance",
          "type": "boolean"
        },
        "required_drill_count": {
          "default": 7,
          "maximum": 32,
          "minimum": 0,
          "title": "Required Drill Count",
          "type": "integer"
        }
      },
      "title": "AnalyticsPolicy",
      "type": "object"
    },
    "ApprovalAttestation": {
      "additionalProperties": false,
      "properties": {
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "comment": {
          "default": "",
          "maxLength": 500,
          "title": "Comment",
          "type": "string"
        },
        "evidence_package_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Package Hash",
          "type": "string"
        },
        "reviewer_id": {
          "maxLength": 128,
          "minLength": 2,
          "title": "Reviewer Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ApprovalRole"
        }
      },
      "required": [
        "role",
        "reviewer_id",
        "approved",
        "approved_at",
        "evidence_package_hash"
      ],
      "title": "ApprovalAttestation",
      "type": "object"
    },
    "ApprovalRole": {
      "enum": [
        "engineering",
        "operations",
        "risk",
        "security",
        "independent_review"
      ],
      "title": "ApprovalRole",
      "type": "string"
    },
    "ArtifactEvidence": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactEvidence",
      "type": "object"
    },
    "BuildAttestation": {
      "additionalProperties": false,
      "properties": {
        "attestation_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Attestation Hash",
          "type": "string"
        },
        "clean_install_passed": {
          "title": "Clean Install Passed",
          "type": "boolean"
        },
        "extracted_source_test_passed": {
          "title": "Extracted Source Test Passed",
          "type": "boolean"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "migration_head": {
          "const": "0009_phase9_release",
          "title": "Migration Head",
          "type": "string"
        },
        "migrations_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Migrations Sha256",
          "type": "string"
        },
        "python_compile_passed": {
          "title": "Python Compile Passed",
          "type": "boolean"
        },
        "release_version": {
          "const": "1.0.2",
          "title": "Release Version",
          "type": "string"
        },
        "schema_count": {
          "exclusiveMinimum": 0,
          "title": "Schema Count",
          "type": "integer"
        },
        "schemas_bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Schemas Bundle Sha256",
          "type": "string"
        },
        "secret_findings": {
          "minimum": 0,
          "title": "Secret Findings",
          "type": "integer"
        },
        "source_archive_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Archive Sha256",
          "type": "string"
        },
        "specification_version": {
          "const": "6.3",
          "title": "Specification Version",
          "type": "string"
        },
        "tests_collected": {
          "exclusiveMinimum": 0,
          "title": "Tests Collected",
          "type": "integer"
        },
        "tests_passed": {
          "minimum": 0,
          "title": "Tests Passed",
          "type": "integer"
        },
        "verification_report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verification Report Sha256",
          "type": "string"
        },
        "wheel_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Wheel Sha256",
          "type": "string"
        },
        "wheel_smoke_test_passed": {
          "title": "Wheel Smoke Test Passed",
          "type": "boolean"
        }
      },
      "required": [
        "generated_at",
        "release_version",
        "specification_version",
        "migration_head",
        "tests_collected",
        "tests_passed",
        "schema_count",
        "secret_findings",
        "clean_install_passed",
        "extracted_source_test_passed",
        "python_compile_passed",
        "wheel_smoke_test_passed",
        "source_archive_sha256",
        "wheel_sha256",
        "migrations_sha256",
        "schemas_bundle_sha256",
        "verification_report_sha256",
        "attestation_hash"
      ],
      "title": "BuildAttestation",
      "type": "object"
    },
