        "trading_date": {
          "format": "date",
          "title": "Trading Date",
          "type": "string"
        },
        "usable_buying_power": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,20}|(?=[\\d.]{1,31}0*$)\\d{0,20}\\.\\d{0,10}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Usable Buying Power"
        }
      },
      "required": [
        "decision_id",
        "request_id",
        "run_id",
        "trading_date",
        "policy_version",
        "profile_name",
        "ticker",
        "final_rank",
        "decision",
        "rejection_reasons",
        "kill_switch_required",
        "session_reference_equity",
        "broker_session_pnl",
        "internal_session_pnl",
        "risk_session_pnl",
        "usable_buying_power",
        "base_trade_risk_budget",
        "risk_flag_multiplier",
        "adjusted_trade_risk_budget",
        "planned_entry_limit",
        "stop_price",
        "target_price",
        "structural_risk_per_share",
        "execution_risk_buffer",
        "modeled_risk_per_share",
        "maximum_total_open_risk",
        "remaining_open_risk_capacity",
        "remaining_hard_loss_capacity",
        "maximum_position_notional",
        "remaining_gross_exposure",
        "quantity_caps",
        "binding_cap",
        "final_quantity",
        "reserved_modeled_risk",
        "reserved_notional",
        "reservation",
        "calculated_at",
        "account_snapshot_timestamp",
        "quote_timestamp",
        "configuration_hash",
        "input_hash",
        "decision_hash"
      ],
      "title": "RiskDecision",
      "type": "object"
    },
    "RiskDecisionStatus": {
      "enum": [
        "approved",
        "rejected"
      ],
      "title": "RiskDecisionStatus",
      "type": "string"
    },
    "RiskProfileName": {
      "enum": [
        "paper_v1",
        "live_pilot_v1"
      ],
      "title": "RiskProfileName",
      "type": "string"
    },
    "RiskRejectionCode": {
      "enum": [
        "ACCOUNT_NOT_ACTIVE",
        "ACCOUNT_BLOCKED",
        "TRADING_BLOCKED",
        "TRADE_SUSPENDED_BY_USER",
        "ACCOUNT_SNAPSHOT_STALE",
        "INVALID_ACCOUNT_VALUE",
        "PENDING_TRANSFER_OUT",
        "ACCOUNT_STATE_UNRECONCILED",
        "STREAM_HEALTH_FAILURE",
        "DATABASE_HEALTH_FAILURE",
        "KILL_SWITCH_ACTIVE",
        "MARKET_NOT_NORMAL",
        "SYMBOL_HALTED",
        "EXECUTION_CUTOFF_EXCEEDED",
        "QUOTE_SNAPSHOT_STALE",
        "LAST_TRADE_STALE",
        "INVALID_QUOTE",
        "REGULAR_SESSION_NBBO_NOT_CONFIRMED",
        "SPREAD_TOO_WIDE",
        "ENTRY_PRICE_DRIFT_TOO_LARGE",
        "ENTRY_LIMIT_NOT_MARKETABLE",
        "INVALID_PRICE_GEOMETRY",
        "PREMARKET_LOW_BROKEN",
        "STOP_ABOVE_PREMARKET_LOW",
        "INVALID_LIQUIDITY_INPUT",
        "SOFT_DAILY_LOSS_LIMIT",
        "HARD_DAILY_LOSS_LIMIT",
        "SESSION_PNL_RECONCILIATION_FAILURE",
        "MAX_CONSECUTIVE_LOSSES",
        "MAX_NEW_ENTRIES_PER_DAY",
        "DUPLICATE_TICKER_DAY",
        "MAX_CONCURRENT_POSITIONS",
        "NO_BUYING_POWER_CAPACITY",
        "NO_OPEN_RISK_CAPACITY",
        "NO_DAILY_LOSS_CAPACITY",
        "NO_GROSS_EXPOSURE_CAPACITY",
        "FINAL_QUANTITY_BELOW_MINIMUM",
        "INVALID_POLICY_CONFIGURATION"
      ],
      "title": "RiskRejectionCode",
      "type": "string"
    },
    "RiskReservation": {
      "additionalProperties": false,
      "properties": {
        "client_order_id": {
          "maxLength": 48,
          "minLength": 1,
          "title": "Client Order Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "reservation_id": {
          "title": "Reservation Id",
          "type": "string"
        },
        "reserved_modeled_risk": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,20}|(?=[\\d.]{1,31}0*$)\\d{0,20}\\.\\d{0,10}0*$)",
              "type": "string"
            }
          ],
          "title": "Reserved Modeled Risk"
        },
        "reserved_notional": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,20}|(?=[\\d.]{1,31}0*$)\\d{0,20}\\.\\d{0,10}0*$)",
              "type": "string"
            }
          ],
          "title": "Reserved Notional"
        },
        "reserved_quantity": {
          "exclusiveMinimum": 0,
          "title": "Reserved Quantity",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ReservationStatus",
