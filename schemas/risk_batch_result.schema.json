        "modeled_risk_per_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,20}|(?=[\\d.]{1,31}0*$)\\d{0,20}\\.\\d{0,10}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Modeled Risk Per Share"
        },
        "planned_entry_limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,20}|(?=[\\d.]{1,31}0*$)\\d{0,20}\\.\\d{0,10}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Planned Entry Limit"
        },
        "policy_version": {
          "const": "position_risk_policy_v1",
          "title": "Policy Version",
          "type": "string"
        },
        "profile_name": {
          "$ref": "#/$defs/RiskProfileName"
        },
        "quantity_caps": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuantityCaps"
            },
            {
              "type": "null"
            }
          ]
        },
        "quote_timestamp": {
          "format": "date-time",
          "title": "Quote Timestamp",
          "type": "string"
        },
        "rejection_reasons": {
          "items": {
            "$ref": "#/$defs/RiskRejectionCode"
