        },
        "ticker": {
          "pattern": "^[A-Z0-9](?:[A-Z0-9.-]{0,13}[A-Z0-9])?$",
          "title": "Ticker",
          "type": "string"
        },
        "trading_date": {
          "format": "date",
          "title": "Trading Date",
          "type": "string"
        }
      },
      "required": [
        "reservation_id",
        "request_id",
        "run_id",
        "trading_date",
        "ticker",
        "client_order_id",
        "reserved_quantity",
        "reserved_notional",
        "reserved_modeled_risk",
        "created_at",
        "expires_at"
      ],
      "title": "RiskReservation",
      "type": "object"
    },
