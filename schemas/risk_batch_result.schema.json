      "enum": [
        "TRADE_RISK",
        "OPEN_RISK",
        "DAILY_LOSS",
        "BUYING_POWER",
        "POSITION_NOTIONAL",
        "GROSS_EXPOSURE",
        "ADV_LIQUIDITY",
        "PREMARKET_LIQUIDITY"
      ],
      "title": "BindingCap",
      "type": "string"
    },
    "QuantityCaps": {
      "additionalProperties": false,
      "properties": {
        "adv_liquidity": {
          "minimum": 0,
          "title": "Adv Liquidity",
          "type": "integer"
        },
        "buying_power": {
          "minimum": 0,
          "title": "Buying Power",
          "type": "integer"
        },
        "daily_loss": {
          "minimum": 0,
          "title": "Daily Loss",
          "type": "integer"
        },
        "gross_exposure": {
          "minimum": 0,
          "title": "Gross Exposure",
          "type": "integer"
        },
        "open_risk": {
          "minimum": 0,
          "title": "Open Risk",
          "type": "integer"
        },
        "position_notional": {
          "minimum": 0,
          "title": "Position Notional",
          "type": "integer"
        },
        "premarket_liquidity": {
          "minimum": 0,
          "title": "Premarket Liquidity",
          "type": "integer"
        },
        "trade_risk": {
          "minimum": 0,
          "title": "Trade Risk",
          "type": "integer"
        }
      },
      "required": [
        "trade_risk",
        "open_risk",
        "daily_loss",
        "buying_power",
        "position_notional",
        "gross_exposure",
        "adv_liquidity",
        "premarket_liquidity"
