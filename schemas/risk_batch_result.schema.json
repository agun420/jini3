            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,20}|(?=[\\d.]{1,31}0*$)\\d{0,20}\\.\\d{0,10}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Adjusted Trade Risk Budget"
        },
        "base_trade_risk_budget": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,20}|(?=[\\d.]{1,31}0*$)\\d{0,20}\\.\\d{0,10}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Base Trade Risk Budget"
        },
        "binding_cap": {
          "anyOf": [
            {
              "$ref": "#/$defs/BindingCap"
