        "remaining_open_risk_capacity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,20}|(?=[\\d.]{1,31}0*$)\\d{0,20}\\.\\d{0,10}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Remaining Open Risk Capacity"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "reservation": {
