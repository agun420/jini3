          "title": "Broker Session Pnl"
        },
        "calculated_at": {
          "format": "date-time",
          "title": "Calculated At",
          "type": "string"
        },
        "configuration_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Hash",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/RiskDecisionStatus"
