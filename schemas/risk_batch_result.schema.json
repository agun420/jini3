            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,20}|(?=[\\d.]{1,31}0*$)\\d{0,20}\\.\\d{0,10}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Execution Risk Buffer"
        },
        "final_quantity": {
          "minimum": 0,
          "title": "Final Quantity",
          "type": "integer"
        },
        "final_rank": {
          "maximum": 3,
          "minimum": 1,
          "title": "Final Rank",
          "type": "integer"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "internal_session_pnl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,20}|(?=[\\d.]{1,31}0*$)\\d{0,20}\\.\\d{0,10}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Internal Session Pnl"
        },
        "kill_switch_required": {
          "title": "Kill Switch Required",
          "type": "boolean"
        },
        "maximum_position_notional": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,20}|(?=[\\d.]{1,31}0*$)\\d{0,20}\\.\\d{0,10}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum Position Notional"
        },
        "maximum_total_open_risk": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,20}|(?=[\\d.]{1,31}0*$)\\d{0,20}\\.\\d{0,10}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum Total Open Risk"
