    "ReservationStatus": {
      "enum": [
        "reserved",
        "submitted",
        "partially_filled",
        "filled",
        "released",
        "expired",
        "reconciliation_required"
      ],
      "title": "ReservationStatus",
      "type": "string"
    },
    "RiskDecision": {
