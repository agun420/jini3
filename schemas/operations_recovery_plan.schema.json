{
  "$defs": {
    "RecoveryAction": {
      "enum": [
        "block",
        "capture_only",
        "reconcile_only",
        "flatten_only",
        "manual_review"
      ],
      "title": "RecoveryAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/RecoveryAction"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "manual_acknowledgement_required": {
      "const": true,
      "default": true,
      "title": "Manual Acknowledgement Required",
      "type": "boolean"
    },
    "may_resume_capture": {
      "title": "May Resume Capture",
      "type": "boolean"
    },
    "may_resume_evaluation": {
      "title": "May Resume Evaluation",
      "type": "boolean"
    },
    "may_resume_new_entries": {
      "const": false,
      "default": false,
      "title": "May Resume New Entries",
      "type": "boolean"
    },
    "plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "plan_id": {
      "maxLength": 64,
      "minLength": 8,
      "title": "Plan Id",
      "type": "string"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "state_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "State Hash",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "generated_at",
    "action",
    "reasons",
    "may_resume_capture",
    "may_resume_evaluation",
    "state_hash",
    "plan_hash"
  ],
  "title": "RecoveryPlan",
  "type": "object"
}
