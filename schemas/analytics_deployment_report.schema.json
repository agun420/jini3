{
  "$defs": {
    "DeploymentStatus": {
      "enum": [
        "incomplete",
        "paper_ready"
      ],
      "title": "DeploymentStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "evidence_hashes": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Evidence Hashes",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "live_deployment_ready": {
      "const": false,
      "default": false,
      "title": "Live Deployment Ready",
      "type": "boolean"
    },
    "migration_head": {
      "const": "0009_phase9_release",
      "title": "Migration Head",
      "type": "string"
    },
    "paper_deployment_ready": {
      "title": "Paper Deployment Ready",
      "type": "boolean"
    },
    "paper_ledger_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Paper Ledger Hash",
      "type": "string"
    },
    "paper_ledger_id": {
      "maxLength": 64,
      "minLength": 8,
      "title": "Paper Ledger Id",
      "type": "string"
    },
    "release_version": {
      "const": "1.0.2",
      "title": "Release Version",
      "type": "string"
    },
    "report_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Hash",
      "type": "string"
    },
    "report_id": {
      "maxLength": 64,
      "minLength": 8,
      "title": "Report Id",
      "type": "string"
    },
    "request_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "schema_count": {
      "exclusiveMinimum": 0,
      "title": "Schema Count",
      "type": "integer"
    },
    "secret_findings": {
      "minimum": 0,
      "title": "Secret Findings",
      "type": "integer"
    },
    "specification_version": {
      "const": "6.3",
      "title": "Specification Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DeploymentStatus"
    },
    "tests_collected": {
      "exclusiveMinimum": 0,
      "title": "Tests Collected",
      "type": "integer"
    },
    "tests_passed": {
      "minimum": 0,
      "title": "Tests Passed",
      "type": "integer"
    }
  },
  "required": [
    "report_id",
    "generated_at",
    "status",
    "paper_deployment_ready",
    "blockers",
    "release_version",
    "specification_version",
    "migration_head",
    "configuration_hash",
    "paper_ledger_id",
    "paper_ledger_hash",
    "tests_collected",
    "tests_passed",
    "schema_count",
    "secret_findings",
    "evidence_hashes",
    "request_hash",
    "report_hash"
  ],
  "title": "DeploymentEvidenceReport",
  "type": "object"
}
