# Never commit real credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_FEED=sip

DAYBREAK_DATABASE_URL=postgresql+psycopg://daybreak:change-me@127.0.0.1:5432/daybreak
DAYBREAK_ENVIRONMENT=paper
DAYBREAK_TIMEZONE=America/New_York
DAYBREAK_CAPTURE_START_ET=04:00:00
DAYBREAK_CAPTURE_STOP_ET=16:05:00
DAYBREAK_PRECONNECT_LEAD_SECONDS=300

# Wildcard minute bars and trading statuses support broad discovery.
# Trades and quotes are intentionally limited to an explicit bounded list.
DAYBREAK_WILDCARD_MINUTE_BARS=true
DAYBREAK_WILDCARD_TRADING_STATUSES=true
DAYBREAK_TICK_SYMBOLS=AAPL,MSFT,NVDA
DAYBREAK_NEWS_SYMBOLS=*
DAYBREAK_MAX_TICK_SYMBOLS=500

DAYBREAK_QUEUE_MAXSIZE=100000
DAYBREAK_BATCH_SIZE=1000
DAYBREAK_FLUSH_INTERVAL_SECONDS=0.25
DAYBREAK_ENQUEUE_TIMEOUT_SECONDS=5
DAYBREAK_SHUTDOWN_TIMEOUT_SECONDS=15
DAYBREAK_STREAM_CONNECT_TIMEOUT_SECONDS=20

# Required when SEC CIK polling is enabled.
SEC_USER_AGENT=Project Daybreak operations@example.com
DAYBREAK_SEC_CIKS=0000320193,0000789019
DAYBREAK_SEC_POLL_INTERVAL_SECONDS=60
DAYBREAK_SEC_BOOTSTRAP_LOOKBACK_HOURS=96
DAYBREAK_SEC_REQUESTS_PER_SECOND=5
DAYBREAK_SEC_TIMEOUT_SECONDS=15

DAYBREAK_LOG_LEVEL=INFO
DAYBREAK_STATE_DIRECTORY=/var/lib/daybreak
